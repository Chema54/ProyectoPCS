<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="900.0" stylesheets="@../estilos/SubMenuStyle.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.aplicacion.controladores.coordinador.GUIAdministrarPracticantes">
    <children>
      <TabPane prefHeight="549.0" prefWidth="900.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab fx:id="tabIntern" text="Practicantes">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tvInterns" layoutX="40.0" layoutY="75.0" prefHeight="378.0" prefWidth="820.0">
                          <columns>
                            <TableColumn fx:id="colInternUser" minWidth="-1.0" prefWidth="178.0" text="Usuario&#10;" />
                              <TableColumn fx:id="colInternEnrollment" minWidth="-1.0" prefWidth="170.0" text="Matricula" />
                              <TableColumn fx:id="colInternName" minWidth="-1.0" prefWidth="248.0" text="Nombre del Practicante" />
                              <TableColumn fx:id="colInternStatus" prefWidth="224.0" text="Estado del Usuario" />
                          </columns>
                        </TableView>
                        <Button fx:id="btnModifyIntern" layoutX="40.0" layoutY="31.0" mnemonicParsing="false" onAction="#handleModifyIntern" prefHeight="25.0" prefWidth="160.0" text="Modificar Practicante" />
                        <Button fx:id="btnRegisterIntern" layoutX="700.0" layoutY="31.0" mnemonicParsing="false" onAction="#handleRegisterIntern" prefHeight="25.0" prefWidth="160.0" text="Registrar Practicante" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab fx:id="tabProfessor" text="Profesores">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tvProfessors" layoutX="38.0" layoutY="75.0" prefHeight="378.0" prefWidth="820.0">
                           <columns>
                              <TableColumn minWidth="-1.0" prefWidth="250.0" text="Usuario" />
                              <TableColumn minWidth="-1.0" prefWidth="250.0" text="No. de Personal" />
                              <TableColumn minWidth="-1.0" prefWidth="320.0" text="Nombre del Profesor" />
                           </columns>
                        </TableView>
                        <Button fx:id="btnModifyProfessor" layoutX="38.0" layoutY="31.0" mnemonicParsing="false" onAction="#handleModifyProfessor" prefHeight="25.0" prefWidth="140.0" text="Modificar Profesor" />
                        <Button fx:id="btnRegisterProfessor" layoutX="718.0" layoutY="31.0" mnemonicParsing="false" onAction="#handleRegisterProfessor" prefHeight="25.0" prefWidth="140.0" text="Registrar Profesor&#10;" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab fx:id="tabCoordinator" text="Coordinadores">
               <content>
                  <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tableViewCoordinator" layoutX="38.0" layoutY="75.0" prefHeight="378.0" prefWidth="820.0">
                           <columns>
                              <TableColumn fx:id="columnUser" minWidth="-1.0" prefWidth="200.0" text="Usuario" />
                              <TableColumn fx:id="columnAcademicNumber" minWidth="-1.0" prefWidth="300.0" text="No. de Personal" />
                              <TableColumn fx:id="columnName" minWidth="-1.0" prefWidth="320.0" text="Nombre del Coordinador" />
                           </columns>
                        </TableView>
                        <Button fx:id="btnRegisterCoordinator" layoutX="653.0" layoutY="31.0" mnemonicParsing="false" onAction="#handleRegisterCoordinator" prefHeight="28.0" prefWidth="205.0" text="Registrar Coordinador" />
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
