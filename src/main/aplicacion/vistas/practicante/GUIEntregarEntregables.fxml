<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane"
            prefHeight="550.0"
            prefWidth="700.0"
            stylesheets="@../estilos/SubMenuStyle.css"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.aplicacion.controladores.practicante.GUIEntregarEntregables">

    <children>
        <TabPane layoutX="20.0"
                 layoutY="20.0"
                 prefHeight="510.0"
                 prefWidth="660.0"
                 tabClosingPolicy="UNAVAILABLE">

            <tabs>
                <Tab text="Reportes">
                    <content>
                        <AnchorPane prefHeight="480.0" prefWidth="660.0">
                            <children>
                                <Label layoutX="20.0"
                                       layoutY="20.0"
                                       text="Mis Reportes de Prácticas">
                                    <font>
                                        <Font size="24.0" />
                                    </font>
                                </Label>

                                <TableView fx:id="tablaReportes"
                                           layoutX="20.0"
                                           layoutY="65.0"
                                           prefHeight="340.0"
                                           prefWidth="620.0">
                                    <columns>
                                        <TableColumn fx:id="columnaNombreReporte"
                                                     prefWidth="400.0"
                                                     text="Reporte" />
                                        <TableColumn fx:id="columnaEstadoReporte"
                                                     prefWidth="218.0"
                                                     text="Estado" />
                                    </columns>
                                </TableView>

                                <Button layoutX="255.0"
                                        layoutY="425.0"
                                        mnemonicParsing="false"
                                        onAction="#entregarReporte"
                                        prefHeight="30.0"
                                        prefWidth="150.0"
                                        text="Entregar Reporte" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab text="Evaluaciones OV">
                    <content>
                        <AnchorPane prefHeight="480.0" prefWidth="660.0">
                            <children>
                                <Label layoutX="20.0"
                                       layoutY="20.0"
                                       text="Evaluaciones de Organización Vinculada">
                                    <font>
                                        <Font size="24.0" />
                                    </font>
                                </Label>

                                <TableView fx:id="tablaEvaluacionesOV"
                                           layoutX="20.0"
                                           layoutY="65.0"
                                           prefHeight="340.0"
                                           prefWidth="620.0">
                                    <columns>
                                        <TableColumn fx:id="columnaNombreEvaluacionOV"
                                                     prefWidth="400.0"
                                                     text="Evaluación" />
                                        <TableColumn fx:id="columnaEstadoEvaluacionOV"
                                                     prefWidth="218.0"
                                                     text="Estado" />
                                    </columns>
                                </TableView>

                                <Button layoutX="245.0"
                                        layoutY="425.0"
                                        mnemonicParsing="false"
                                        onAction="#entregarEvaluacion"
                                        prefHeight="30.0"
                                        prefWidth="170.0"
                                        text="Entregar Evaluación" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab text="Autoevaluación">
                    <content>
                        <AnchorPane prefHeight="480.0" prefWidth="660.0">
                            <children>
                                <Label layoutX="20.0"
                                       layoutY="20.0"
                                       text="Realizar Autoevaluación">
                                    <font>
                                        <Font size="24.0" />
                                    </font>
                                </Label>

                                <TableView fx:id="tablaAutoevaluaciones"
                                           layoutX="20.0"
                                           layoutY="65.0"
                                           prefHeight="340.0"
                                           prefWidth="620.0">
                                    <columns>
                                        <TableColumn fx:id="columnaNombreAutoevaluacion"
                                                     prefWidth="400.0"
                                                     text="Autoevaluación" />
                                        <TableColumn fx:id="columnaEstadoAutoevaluacion"
                                                     prefWidth="218.0"
                                                     text="Estado" />
                                    </columns>
                                </TableView>

                                <Button layoutX="245.0"
                                        layoutY="425.0"
                                        mnemonicParsing="false"
                                        onAction="#realizarAutoevaluacion"
                                        prefHeight="30.0"
                                        prefWidth="170.0"
                                        text="Realizar Formulario" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>