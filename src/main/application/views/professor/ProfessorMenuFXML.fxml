            <Button fx:id="buttonCloseSession" mnemonicParsing="false" onAction="#handleCloseSession" prefHeight="46.0" prefWidth="137.0" style="-fx-background-color: #424242;" text="Cerrar sesión" textFill="WHITE">
               <font>
                  <Font size="18.0" />
