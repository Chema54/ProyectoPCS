<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" stylesheets="@../styles/SidebarStyle.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.application.controllers.professor.ProfessorMenuFXMLController">
    <children>
      <HBox prefHeight="46.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #25A794;">
