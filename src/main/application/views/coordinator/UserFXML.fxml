                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab fx:id="tabCoordinator" text="Coordinadores">
               <content>
                  <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tableViewCoordinator" layoutX="38.0" layoutY="75.0" prefHeight="378.0" prefWidth="584.0">
                           <columns>
                              <TableColumn fx:id="columnUser" minWidth="-1.0" prefWidth="132.0" text="Usuario" />
                              <TableColumn fx:id="columnAcademicNumber" minWidth="-1.0" prefWidth="247.0" text="No. de Personal" />
