                              <TableColumn prefWidth="186.0" text="Estado del Usuario" />
                          </columns>
                        </TableView>
                        <TextField fx:id="textFieldSearchCoordinators" layoutX="37.0" layoutY="32.0" prefHeight="25.0" prefWidth="295.0" promptText="Ingrese el nombre del Practicante" />
                        <ComboBox layoutX="352.0" layoutY="32.0" prefHeight="25.0" prefWidth="126.0" promptText="Filtrar" />
                        <Button layoutX="500.0" layoutY="25.0" mnemonicParsing="false" onAction="#goToRegisterCoordinator" prefHeight="40.0" prefWidth="124.0" text="Registrar &#10;Practicante" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab fx:id="tabProfessor" text="Profesores">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView layoutX="38.0" layoutY="75.0" prefHeight="378.0" prefWidth="584.0">
                           <columns>
                              <TableColumn minWidth="-1.0" prefWidth="168.0" text="Usuario" />
                              <TableColumn minWidth="-1.0" prefWidth="211.0" text="No. de Personal" />
                              <TableColumn minWidth="-1.0" prefWidth="203.0" text="Nombre del Profesor" />
                           </columns>
                        </TableView>
                        <Button layoutX="502.0" layoutY="31.0" mnemonicParsing="false" onAction="#goToRegisterCoordinator" prefHeight="25.0" prefWidth="120.0" text="Registrar Profesor&#10;" />
                        <ComboBox layoutX="350.0" layoutY="31.0" prefHeight="25.0" prefWidth="126.0" promptText="Filtrar" />
