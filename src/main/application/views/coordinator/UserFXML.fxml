                        <TableView layoutX="40.0" layoutY="75.0" prefHeight="378.0" prefWidth="584.0">
                          <columns>
                            <TableColumn minWidth="-1.0" prefWidth="118.0" text="Usuario&#10;" />
                              <TableColumn minWidth="-1.0" prefWidth="120.0" text="Matricula" />
