<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" stylesheets="@../../styles/FormsStyle.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.application.controllers.coordinator.user.RegisterUserCoordinatorFXMLController">

    <children>

        <Label layoutX="40.0" layoutY="30.0" text="Registrar Coordinador">
         <font>
            <Font size="22.0" />
         </font></Label>

        <Label layoutX="40.0" layoutY="80.0" text="Nombre Completo" />
        <TextField fx:id="textFieldName" layoutX="180.0" layoutY="75.0" prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="130.0" text="No. de Personal" />
        <TextField fx:id="textFieldAcademicNumber" layoutX="180.0" layoutY="125.0" prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="180.0" text="Nombre de Usuario" />
        <TextField fx:id="textFieldUsername" layoutX="180.0" layoutY="175.0" prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="230.0" text="Contraseña" />
        <PasswordField fx:id="passwordFieldPassword" layoutX="180.0" layoutY="225.0" prefWidth="250.0" />

        <Button fx:id="buttonRegister" layoutX="180.0" layoutY="300.0" mnemonicParsing="false" onAction="#registerCoordinator" text="Registrar" />

        <Button layoutX="300.0" layoutY="300.0" mnemonicParsing="false" onAction="#cancel" text="Cancelar" />

    </children>

</AnchorPane>
